<div>
    <label class="block text-sm font-medium">Judul Tugas</label>
    <input type="text" id="task-title" class="w-full border rounded p-2" placeholder="Minimal 3 karakter...">
    <p id="title-error" class="text-red-500 text-xs mt-1 hidden">Judul tugas minimal harus 3 karakter.</p>
</div>

<div>
    <label class="block text-sm font-medium">Tenggat Waktu (Deadline)</label>
    <input type="date" id="task-deadline" class="w-full border rounded p-2">
    <p id="date-error" class="text-red-500 text-xs mt-1 hidden">Tenggat waktu tidak boleh tanggal yang sudah lewat.</p>
</div>